@model IEnumerable<FineDimSum.Models.CartItem>

<div id="cart-container">
    <table class="table table-hover align-middle">
        <thead class="table-Light">
            <tr>
                <th scope="col">Product Details</th>
                <th scope="col" class="text-start">Quantity</th>
                <th scope="col" class="text-center">Unit Price (RM)</th>
                <th scope="col" class="text-center">Final Price (RM)</th>
                <th scope="col" class="text-center">Remove</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">
                        <strong>No items in the cart.</strong>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr style="font-size:18px">
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="/images/AdmProduct/ProductVariationOption/@item.ProductVariationOption.Image"
                                     alt="@item.ProductVariationOption.Name"
                                     class="me-3 m-2"
                                     style="width: 130px; height: 130px; border-radius: 15px; background-color: rgba(0, 0, 0, 0.05);">
                                <div>
                                    <strong>@item.ProductVariationOption.Product.Name</strong>
                                    <p class="mb-1"><small>@item.ProductVariationOption.Name</small></p>
                                    <form action="/CustCart/UpdateRemark" method="post">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <div class="d-flex align-items-center">
                                            <label for="remark-@item.Id" class="form-label me-2">Remark:</label>
                                            <input type="text"
                                                   id="remark-@item.Id"
                                                   name="remark"
                                                   max="50"
                                                   class="form-control w-75"
                                                   value="@item.Remark" />
                                            <button type="submit" class="btn btn-secondary btn-sm ms-2">&#9998;</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <form action="/CustCart/UpdateQuantity" method="post">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <div class="d-flex align-items-center">
                                    <input type="number"
                                           name="quantity"
                                           class="quantity-input form-control w-auto"
                                           style="width: 70px !important;"
                                           value="@item.Quantity"
                                           min="1"
                                           max="999" />
                                    <button type="submit" class="btn btn-secondary btn-sm ms-2">&#9998;</button>
                                </div>
                            </form>
                        </td>
                        <td class="text-center">@item.ProductVariationOption.UnitPrice.ToString("F2")</td>
                            <td class="text-center">
                                @((item.Quantity * item.ProductVariationOption.UnitPrice).ToString("F2"))
                            </td>
                        <td class="text-center">
                            <a href="/CustCart/RemoveFromCart?cartItemId=@item.Id"
                               data-ajax="true"
                               data-ajax-update="#cart-container"
                               data-ajax-method="POST"
                               class="btn btn-danger fw-bold">
                                X
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>

    </table>

    <div class="mt-4">
            <h5>
                <strong>Subtotal for Cart (RM):</strong>
                <span>@Model.Sum(ci => ci.Quantity * ci.ProductVariationOption.UnitPrice).ToString("F2")</span>
            </h5>
    </div>

    <div class="d-flex justify-content-between mt-3">
        <a href="/CustCart/ClearCart"
           data-ajax="true"
           data-ajax-update="#cart-container"
           data-ajax-method="POST"
           class="red-button">
            Clear Cart
        </a>
        <button data-post="/CustOrder/CreateOrder" class="gradient-button">Place Order</button>
    </div>
</div>