@{
    ViewBag.Title = "Fine Dim Sum | Error";
}


<style>
    .error-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        min-height: 100vh;
        padding: 20px;
    }

    .error-image {
        width: 100%;
        height: auto;
        cursor: pointer;
        border-radius: 10px;
    }

    .error-link {
        text-decoration: none;
    }
</style>

<div class="error-container">
    <a href="javascript:history.back();" class="error-link">
        <img src="/images/Icon/ErrorPage.png" alt="Error Image" class="error-image" />
    </a>
</div>




