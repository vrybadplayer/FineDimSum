@model PastOrderDetailsViewModel
@section head {
    <link rel="stylesheet" href="/css/custPastOrders.css" asp-append-version="true" />
}
@{
    ViewBag.Title = "Fine Dim Sum | Order Details";
}

<div class="container my-4">
    <div class="header">
        <div class="title">Order Details</div>
    </div>
    <div class="underline mb-2"></div>


    <div class="row mb-2">
        <div class="col-md-6">
            <p><strong>Order ID: @Model.OrderId</strong> </p>
            <p><strong>Order Date: @Model.OrderDate</strong> </p>
        </div>
        <div class="col-md-6 text-md-end">
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table align-middle">
            <thead class="table-Light">
                <tr>
                    <th scope="col">Product Details</th>
                    <th scope="col" class="text-center">Quantity</th>
                    <th scope="col" class="text-center">Unit Price (RM)</th>
                    <th scope="col" class="text-center">Final Price (RM)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr style="font-size:18px">
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="/images/Order/@item.ProductImage" alt="@item.ProductName" class="me-3 m-2"
                                     style="width: 130px; height: 130px; border-radius: 15px; background-color: rgba(0, 0, 0, 0.05);">
                                <div>
                                    <strong>@item.ProductName</strong>
                                    <p class="mb-1"><small>@item.VariationName</small></p>
                                    <p class="text-muted mb-0">Remark: <small>@item.Remark</small></p>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-center">@item.UnitPrice.ToString("F2")</td>
                        <td class="text-center">@item.FinalPrice.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row mt-4">
        <div class="col-md-7">
        </div>
        <div class="col-md-5">
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between pt-3 pb-3">
                    <span class="fs-6 grey"><strong>Subtotal (RM)</strong></span>
                    <strong>@Model.Subtotal.ToString("F2")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between pb-3">
                    <span class="fs-6 grey"><strong>Tax (RM)</strong></span>
                    <strong>@Model.Tax.ToString("F2")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between pb-3">
                    <span class="fs-6 grey"><strong>Service Charge (RM)</strong></span>
                    <strong>@Model.ServiceCharge.ToString("F2")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between pb-3">
                    <span class="fs-6 grey"><strong>Discount (RM)</strong></span>
                    <strong>(-) @Model.Discount.ToString("F2")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between pb-3">
                    <span class="fs-6 grey"><strong>Total (RM)</strong></span>
                    <strong>@Model.Total.ToString("F2")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between pb-3">
                    <span class="fs-6 grey"><strong>Earned Points</strong></span>
                    <strong>@Math.Floor(Model.Total * 10)</strong>
                </li>
            </ul>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-4">
        <form method="get" action="/CustOrder/PastOrders">
            <button type="submit" class="gradient-button" style="font-size:16px">Back to Orders</button>
        </form>
    </div>

</div>
